# Database Configuration
DATABASE_URL=postgresql://eduser:edpassword@postgres:5432/education_platform
DB_USER=eduser
DB_PASSWORD=edpassword
DB_NAME=education_platform

# JWT Configuration
SECRET_KEY=your-secret-key-change-this-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# Frontend Configuration
